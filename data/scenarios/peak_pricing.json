{
  "schema_version": 1,
  "name": "peak_pricing",
  "title": "Peak pricing: +30% inside the two demand peaks, elastic demand response",
  "provenance": {
    "source": "Synthetic, anchored on the Course 5006 campus demand shape and on teaching-case ranges for food-service peak surcharges and price elasticities",
    "method": "campus_rush demand shape with a +30% price inside the two peak windows and a constant-elasticity response (elasticity -1.2, i.e. a 30% surcharge removes about 27% of peak demand); the quoted arrival rate is the no-pricing daily mean, so the realised mean is lower",
    "uncertainty": "high",
    "notes": "Not field-measured. The elasticity is an assumption, not an estimate; the point is the mechanism (peak demand deflation) and the trade-off between peak waiting relief and revenue. Because the price layer changes the realised daily mean, compare it against campus_rush on served/profit/p95, not on the quoted arrival rate."
  },
  "base": {
    "workers": 5,
    "arrival_rate": 1.15,
    "sim_minutes": 480.0,
    "warmup_minutes": 60.0
  },
  "demand": {
    "segments": [[0.0, 0.5], [60.0, 1.7], [180.0, 0.6], [300.0, 1.6], [420.0, 0.8]],
    "normalize_daily_mean": 1.0
  },
  "batches": {
    "probability": 0.15,
    "sizes": [[2, 0.6], [3, 0.3], [4, 0.1]]
  },
  "classes": [
    {
      "name": "regular",
      "weight": 0.72,
      "patience": {"balk_mean": 9.0, "balk_cv": 0.5, "renege_mean": 16.0, "renege_cv": 0.6},
      "priority": 1
    },
    {
      "name": "student",
      "weight": 0.20,
      "mix": {"tea": 0.68, "bread": 0.13, "ice": 0.05, "mix": 0.14},
      "patience": {"balk_mean": 5.0, "balk_cv": 0.4, "renege_mean": 9.0, "renege_cv": 0.5},
      "priority": 1
    },
    {
      "name": "delivery",
      "weight": 0.08,
      "delivery": true,
      "priority": 1
    }
  ],
  "variability": {
    "kind": "lognormal",
    "order_cv": 0.10,
    "tea_cv": 0.35,
    "bread_cv": 0.15,
    "ice_cv": 0.25
  },
  "pricing": {
    "peak_windows": [[60.0, 180.0], [300.0, 420.0]],
    "peak_price_multiplier": 1.3,
    "elasticity": -1.2
  },
  "network": {
    "stations": [
      {"name": "order", "capacity": 2, "skill": "cashier"},
      {"name": "tea", "capacity": 3, "skill": "barista"},
      {"name": "ice", "capacity": 1, "skill": "barista"},
      {"name": "bread", "capacity": 2, "skill": "cashier"}
    ],
    "staff": {
      "roles": ["cashier", "barista"],
      "counts": [2, 3],
      "skills": [["cashier"], ["barista"]],
      "windows": [
        {"role": "cashier", "start": 0.0, "end": 480.0},
        {"role": "cashier", "start": 0.0, "end": 480.0},
        {"role": "barista", "start": 0.0, "end": 480.0},
        {"role": "barista", "start": 0.0, "end": 480.0},
        {"role": "barista", "start": 60.0, "end": 480.0}
      ],
      "breaks": [
        {"role": "cashier", "start": 240.0, "end": 270.0},
        {"role": "barista", "start": 300.0, "end": 330.0}
      ]
    },
    "routes": [
      ["tea", "tea"], ["mix_tea", "tea"],
      ["ice", "ice"], ["mix_ice", "ice"],
      ["bread", "bread"]
    ]
  },
  "policy": {
    "split_mix": false,
    "fast_priority": true
  }
}
