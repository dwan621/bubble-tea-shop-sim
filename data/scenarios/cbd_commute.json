{
  "schema_version": 1,
  "name": "cbd_commute",
  "title": "CBD commuter shop: short morning grab-and-go peak plus a lunch peak",
  "provenance": {
    "source": "Synthetic, anchored on the Course 5006 parameter set (order mix, make times, prices) and on teaching-case ranges for commuter-district peak-to-average ratios",
    "method": "Piecewise-constant demand from an assumed commuter day (soft open, sharp 120-minute morning peak, midday trough, lunch peak, soft close); daily mean normalised to the quoted rate; stations and staff sized so the peaks are feasible but tight",
    "uncertainty": "high",
    "notes": "Not field-measured. The morning peak is shorter and sharper than the lunch peak; peak segments run ~1.8x the daily mean. Ten-hour modelled day so both peaks fit. Batches are small (commuters rarely arrive in groups)."
  },
