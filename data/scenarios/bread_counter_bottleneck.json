{
  "schema_version": 1,
  "name": "bread_counter_bottleneck",
  "title": "Bread counter bottleneck: one toaster slot, bread-heavy order mix",
  "provenance": {
    "source": "Synthetic: Course 5006 service-time structure with an assumed single-slot toaster/warmer, plus teaching-case ranges for bakery-attach rates",
    "method": "Bread make time raised to 1.5 min per portion at a single-slot counter, bread share raised to 45% of orders, two cashiers and two tea slots so the bread counter is the structural bottleneck",
    "uncertainty": "high",
    "notes": "Not field-measured. The bread counter and the tills are staffed by the same cashier role, so adding a second bread slot is an equipment decision, not a hiring one; the network study uses this to separate equipment capacity from labour capacity."
  },
  "base": {
    "workers": 4,
    "arrival_rate": 0.85,
    "sim_minutes": 480.0,
    "warmup_minutes": 60.0
  },
  "times": {
    "order": 0.5,
    "tea": 2.0,
    "bread": 1.5,
    "ice": 0.333
  },
  "mix": {
    "tea": 0.30,
    "bread": 0.45,
    "ice": 0.05,
    "mix": 0.20
  },
  "batches": {
    "probability": 0.1,
    "sizes": [[2, 0.7], [3, 0.3]]
  },
  "classes": [
    {
      "name": "regular",
      "weight": 0.9,
      "patience": {"balk_mean": 9.0, "balk_cv": 0.5, "renege_mean": 16.0, "renege_cv": 0.6},
      "priority": 1
    },
    {
      "name": "delivery",
      "weight": 0.1,
      "delivery": true,
      "priority": 1
    }
  ],
  "variability": {
    "kind": "lognormal",
    "order_cv": 0.12,
    "tea_cv": 0.30,
    "bread_cv": 0.35,
    "ice_cv": 0.25
  },
  "network": {
    "stations": [
      {"name": "order", "capacity": 2, "skill": "cashier"},
      {"name": "tea", "capacity": 2, "skill": "barista"},
      {"name": "ice", "capacity": 1, "skill": "barista"},
      {"name": "bread", "capacity": 1, "skill": "cashier"}
    ],
    "staff": {
      "roles": ["cashier", "barista"],
      "counts": [2, 2],
      "skills": [["cashier"], ["barista"]],
      "windows": [
        {"role": "cashier", "start": 0.0, "end": 480.0},
        {"role": "cashier", "start": 0.0, "end": 480.0},
        {"role": "barista", "start": 0.0, "end": 480.0},
        {"role": "barista", "start": 0.0, "end": 480.0}
      ]
    },
    "routes": [
      ["tea", "tea"], ["mix_tea", "tea"],
      ["ice", "ice"], ["mix_ice", "ice"],
      ["bread", "bread"]
    ]
  },
  "policy": {
    "split_mix": false,
    "fast_priority": true
  }
}
