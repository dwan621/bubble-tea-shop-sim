					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Sink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Sink]]></ClassName>
							<ItemName><![CDATA[1412336242929]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// Revenue: split mixed orders contribute tea and ice components separately.
double itemRevenue = 0;
if (agent.orderType == 0) {
	itemRevenue = priceTea;
	teaCount++;
} else if (agent.orderType == 1) {
	itemRevenue = priceBread;
	breadCount++;
} else if (agent.orderType == 2) {
	itemRevenue = priceIce;
	iceCount++;
} else if (agent.orderType == 3) {
	itemRevenue = priceTea;
} else if (agent.orderType == 4) {
	itemRevenue = priceIce;
	if (mixSplit) mixCount++;
} else if (agent.orderType == 5) {
	itemRevenue = priceTea + priceIce;
	mixCount++;
}

revenueTotal += itemRevenue;
if (agent.orderType != 4) servedCount++;

// Waiting cost is counted once per customer; for a split mixed order, use its tea component.
boolean countWaitingCost = (agent.orderType == 0 || agent.orderType == 1 || agent.orderType == 2 || agent.orderType == 3 || agent.orderType == 5);
if (countWaitingCost) {
	flowTimeTotal += time() - agent.arrivalTime;
}

double hoursElapsed = time() / 60.0;
if (hoursElapsed > 0) {
	revenuePerHour = revenueTotal / hoursElapsed;
	profitPerHour = (revenueTotal - workers * wagePerWorkerHour * hoursElapsed - waitingCostPerMin * flowTimeTotal) / hoursElapsed;
}
if (time() > 999.5) {
	System.out.println("E1 profitPerHour=" + profitPerHour + " revenuePerHour=" + revenuePerHour + " servedCount=" + servedCount + " teaCount=" + teaCount + " breadCount=" + breadCount + " iceCount=" + iceCount + " mixCount=" + mixCount);
}]]></Code>
							</Value>
						</Parameter>
